FLASK_ENV=production
SOFTWARE_NAME=FileShareApp
SHOW_DELETE_ON_READ=true
SHOW_PASSWORD_PROTECT=true
CONTACT_EMAIL=
TITLE_UPLOAD_FILE="Téléverser un Fichier"
TITLE_DOWNLOAD_FILE="Télécharger un Fichier"
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
MAX_FILE_SIZE="10"
