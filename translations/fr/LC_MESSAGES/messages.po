# ── app.py messages ──────────────────────────────────────────────────────────

msgid "Please log in to access this page."
msgstr "Veuillez vous connecter pour accéder à cette page."

msgid "Registrations are disabled."
msgstr "Les inscriptions sont désactivées."

msgid "Account created! You can now log in."
msgstr "Compte créé ! Vous pouvez vous connecter."

msgid "This username is already taken."
msgstr "Ce nom d'utilisateur est déjà pris."

msgid "Account locked. Try again in %(n)s minute(s)."
msgstr "Compte verrouillé. Réessayez dans %(n)s minute(s)."

msgid "Account locked for %(n)s minutes after too many failed attempts."
msgstr "Compte verrouillé pendant %(n)s minutes après trop de tentatives."

msgid "Incorrect credentials."
msgstr "Identifiants incorrects."

msgid "Invalid or already used link."
msgstr "Lien invalide ou déjà utilisé."

msgid "This link has expired. Ask the administrator for a new one."
msgstr "Ce lien a expiré. Demandez un nouveau lien à l'administrateur."

msgid "Password updated. You can now log in."
msgstr "Mot de passe modifié. Vous pouvez vous connecter."

msgid "Internal MFA error. Please contact the administrator."
msgstr "Erreur interne MFA. Contactez l'administrateur."

msgid "Invalid TOTP code."
msgstr "Code TOTP invalide."

msgid "Current password is incorrect."
msgstr "Mot de passe actuel incorrect."

msgid "Password updated."
msgstr "Mot de passe modifié."

msgid "Session expired, please try again."
msgstr "Session expirée, recommencez."

msgid "Invalid code. Please try again."
msgstr "Code invalide. Réessayez."

msgid "TOTP disabled."
msgstr "TOTP désactivé."

msgid "No recovery codes to display."
msgstr "Aucun code de récupération à afficher."

msgid "Enable TOTP first to generate recovery codes."
msgstr "Activez d'abord le TOTP pour générer des codes de récupération."

msgid "Invalid recovery code."
msgstr "Code de récupération invalide."

msgid "Security key deleted."
msgstr "Clé de sécurité supprimée."

msgid "Incorrect confirmation. Type exactly \"supprimer\" to confirm."
msgstr "Confirmation incorrecte. Tapez exactement « supprimer » pour valider."

msgid "Your account and all your data have been permanently deleted."
msgstr "Votre compte et l'ensemble de vos données ont été supprimés définitivement."

msgid "The recipient has no storage space left."
msgstr "Le destinataire n'a plus d'espace de stockage disponible."

msgid "The recipient has reached their file quota."
msgstr "Le destinataire a atteint son quota de fichiers."

msgid "File rejected: threat detected (%(threat)s)."
msgstr "Fichier refusé : menace détectée (%(threat)s)."

msgid "Internal error while saving the file."
msgstr "Erreur interne lors de l'enregistrement."

msgid "File type not allowed."
msgstr "Type de fichier non autorisé."

msgid "Settings saved."
msgstr "Paramètres sauvegardés."

msgid "You cannot delete your own account."
msgstr "Impossible de supprimer votre propre compte."

msgid "You cannot change your own admin rights."
msgstr "Impossible de modifier vos propres droits."

msgid "User not found."
msgstr "Utilisateur introuvable."

msgid "Cannot reset the password of an SSO account."
msgstr "Impossible de réinitialiser le mot de passe d'un compte SSO."

msgid "Unable to contact the SSO provider."
msgstr "Impossible de contacter le fournisseur SSO."

msgid "SSO configuration saved."
msgstr "Configuration SSO sauvegardée."

msgid "Storage configuration saved."
msgstr "Configuration du stockage sauvegardée."

msgid "Legal notices and Terms of Service saved."
msgstr "Mentions légales et CGU sauvegardées."

msgid "Two-factor authentication (2FA) is required. Please enable it on your profile."
msgstr "La double authentification (2FA) est obligatoire. Veuillez l'activer sur votre profil."

msgid "Incorrect password."
msgstr "Mot de passe incorrect."

msgid "No file or file type not allowed."
msgstr "Fichier absent ou type non autorisé."

msgid "File too large (max %(n)s MB)."
msgstr "Fichier trop grand (max %(n)s Mo)."

msgid "Quota reached (%(n)s files maximum)."
msgstr "Quota atteint (%(n)s fichiers maximum)."

msgid "Storage quota exceeded (%(n)s %(unit)s maximum)."
msgstr "Quota de stockage dépassé (%(n)s %(unit)s maximum)."

msgid "Invalid custom date format."
msgstr "Format de date personnalisée invalide."

msgid "The expiry date must be in the future."
msgstr "La date d'expiration doit être dans le futur."

msgid "The expiry date cannot exceed 1 year."
msgstr "La date d'expiration ne peut pas dépasser 1 an."

msgid "Download count must be ≥ 1."
msgstr "Le nombre de téléchargements doit être ≥ 1."

msgid "Invalid download count."
msgstr "Nombre de téléchargements invalide."

msgid "At least 2 files required."
msgstr "Au moins 2 fichiers requis."

msgid "File not found."
msgstr "Fichier introuvable."

msgid "Bucket name is required."
msgstr "Nom du bucket manquant."

msgid "Successfully connected to bucket \"%(bucket)s\"."
msgstr "Connexion réussie au bucket « %(bucket)s »."

msgid "File too large (server limit exceeded)."
msgstr "Fichier trop grand (limite serveur dépassée)."

msgid "boto3 is not installed on this server."
msgstr "boto3 non installé sur ce serveur."

